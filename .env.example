# Run all commands from the repository root.
DATABASE_URL=sqlite:///./outliers.db
AI_PROVIDER=mock
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MAX_IMAGE_BYTES=5242880
# Optional PostgreSQL: create the DB/user first, then replace DATABASE_URL.
# DATABASE_URL=postgresql+psycopg://outliers:CHANGE_ME@localhost:5432/outliers
# Gemini scripts in src/ai/ (key from Google AI Studio; keep it only in .env).
# GEMINI_API_KEY=

